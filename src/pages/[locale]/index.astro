---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { type Locale } from "../../data/books";

export function getStaticPaths() {
  return ["pt", "en"].map((locale) => ({
    params: { locale },
    props: { locale: locale as Locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const homeSeo = locale === "pt"
  ? {
      title: "Roberto Vinicius | Desenvolvedor Full Stack & DevOps",
      description: "Portfólio profissional de Roberto Vinicius. Especialista em PHP, Laravel, Vue.js, React, Docker e DevOps.",
    }
  : {
      title: "Roberto Vinicius | Full Stack Developer & DevOps",
      description: "Professional portfolio of Roberto Vinicius. Specialized in PHP, Laravel, Vue.js, React, Docker, and DevOps.",
    };

const particleTitle = "ROBERTO VINICIUS";
const alternatePaths = { pt: "/pt/", en: "/en/" };

const navItems = locale === "pt" ? [
  { label: "Perfil", href: "#perfil" },
  { label: "Sobre mim", href: "#sobre" },
  { label: "Habilidades", href: "#habilidades" },
  { label: "Carreira", href: "#experiencia" },
  { label: "Projetos", href: "#projetos" },
  { label: "Contato", href: "#contato" },
] : [
  { label: "Profile", href: "#perfil" },
  { label: "About", href: "#sobre" },
  { label: "Skills", href: "#habilidades" },
  { label: "Career", href: "#experiencia" },
  { label: "Projects", href: "#projetos" },
  { label: "Contact", href: "#contato" },
];

const skillsData = [
  {
    category: locale === "pt" ? "Linguagens" : "Languages",
    items: ["JavaScript", "TypeScript", "PHP", "Python", "Bash", "HTML5", "CSS3"],
  },
  {
    category: locale === "pt" ? "Frameworks & Libs" : "Frameworks & Libraries",
    items: ["Laravel", "Vue.js", "React", "Node.js", "Bootstrap", "Tailwind CSS", "Astro"],
  },
  {
    category: "DevOps & Cloud",
    items: ["Docker", "Docker Compose", "CI/CD Pipelines", "Nginx", "Git / GitHub", "Linux", "Zero-Downtime Deploy"],
  },
  {
    category: locale === "pt" ? "Banco de Dados & Outros" : "Databases & Others",
    items: ["PostgreSQL", "MySQL", "PHP-FPM", "REST APIs", "Rotinas de Backup", "Web Services"],
  },
];

const marqueeSkills = [
  "PHP", "Laravel", "Vue.js", "React", "Docker", "Docker Compose",
  "PostgreSQL", "JavaScript", "TypeScript", "Python", "Nginx",
  "CI/CD Pipelines", "Node.js", "Bash Scripting", "Git", "Astro", "Linux"
];

const experiences = locale === "pt" ? [
  {
    role: "Desenvolvedor de Software",
    company: "@SESAP/RN — Secretaria de Estado da Saúde Pública",
    period: "Jan 2025 - Presente",
    description: "Responsável pelo desenvolvimento e sustentação do site e sistemas governamentais da SESAP/RN. Implementação de novos sistemas na área de saúde com PHP (Laravel) e Vue.js, garantindo alta disponibilidade, estabilidade e arquitetura moderna.",
    tags: ["PHP", "Laravel", "Vue.js", "PostgreSQL", "REST APIs"],
  },
  {
    role: "DevOps & Engenharia de Infraestrutura",
    company: "@SESAP/RN — Secretaria de Estado da Saúde Pública",
    period: "Jan 2025 - Presente",
    description: "Desenvolvimento e sustentação de infraestrutura containerizada com Docker e Docker Compose. Implementação de pipelines automatizados de CI/CD, monitoramento Git, rollback automático, rotinas de backup comprimido com verificação de integridade e microsserviços (PHP-FPM 8.2, Nginx, PostgreSQL) com zero-downtime deploy.",
    tags: ["Docker", "Docker Compose", "Nginx", "CI/CD", "Bash", "PostgreSQL", "Linux"],
  },
  {
    role: "Bolsista / Analista de Suporte de TI",
    company: "@BCZM / UFRN — Biblioteca Central Zila Mamede",
    period: "Out 2023 - Jul 2024",
    description: "Suporte técnico aos usuários da biblioteca central, manutenção e montagem de computadores do parque tecnológico, instalação/configuração de softwares corporativos e manutenção de infraestrutura de rede lógica estruturada.",
    tags: ["Hardware", "Redes Lógicas", "Suporte ao Usuário", "Linux / Windows"],
  },
] : [
  {
    role: "Software Developer",
    company: "@SESAP/RN — State Health Secretariat",
    period: "Jan 2025 - Present",
    description: "Responsible for developing and maintaining official systems and web portals for SESAP/RN. Building reliable public health applications with PHP (Laravel) and Vue.js.",
    tags: ["PHP", "Laravel", "Vue.js", "PostgreSQL", "REST APIs"],
  },
  {
    role: "DevOps & Infrastructure Engineer",
    company: "@SESAP/RN — State Health Secretariat",
    period: "Jan 2025 - Present",
    description: "Architecting and managing containerized infrastructures with Docker and Docker Compose. Building automated CI/CD pipelines, Git tracking, automated rollback, backup automation scripts with validation, and microservices (PHP-FPM, Nginx, PostgreSQL) with zero-downtime deploy.",
    tags: ["Docker", "Docker Compose", "Nginx", "CI/CD", "Bash", "PostgreSQL", "Linux"],
  },
  {
    role: "IT Support Analyst",
    company: "@BCZM / UFRN — Central University Library",
    period: "Oct 2023 - Jul 2024",
    description: "Providing tech support to university users, maintaining computer hardware workstations, configuring enterprise software, and maintaining local network cabling infrastructure.",
    tags: ["Hardware", "Networking", "Tech Support", "Linux / Windows"],
  },
];

const projects = locale === "pt" ? [
  {
    tag: "01 · DevOps · Docker · CI/CD · Nginx",
    title: "Infraestrutura Containerizada & CI/CD SESAP",
    description: "Arquitetura completa de microsserviços containerizados para ambiente público de produção com Docker, automação de backups, monitoramento de integridade e rollback automático.",
    link: "https://github.com/Roberto-Vinicius",
  },
  {
    tag: "02 · Full Stack · Laravel · Vue.js · Postgres",
    title: "Sistemas Governamentais de Saúde Pública",
    description: "Aplicações escaláveis desenvolvidas em PHP (Laravel) e Vue.js integradas ao banco PostgreSQL para sustentação e modernização das rotinas da SESAP/RN.",
    link: "https://github.com/Roberto-Vinicius",
  },
  {
    tag: "03 · WebGL · Three.js · Astro · Interativo",
    title: "Portfólio Espacial Interativo 3D",
    description: "Portfólio com simulação espacial 3D em Three.js, partículas interativas e arquitetura estática de alta performance no Astro.",
    link: "https://github.com/Roberto-Vinicius",
  },
] : [
  {
    tag: "01 · DevOps · Docker · CI/CD · Nginx",
    title: "Containerized Infrastructure & CI/CD SESAP",
    description: "Complete microservices container architecture for government production environments with Docker, automated backups, and rollback pipelines.",
    link: "https://github.com/Roberto-Vinicius",
  },
  {
    tag: "02 · Full Stack · Laravel · Vue.js · Postgres",
    title: "Public Health Management Systems",
    description: "Scalable enterprise web applications built with PHP (Laravel) and Vue.js with PostgreSQL backend integrations for state health administration.",
    link: "https://github.com/Roberto-Vinicius",
  },
  {
    tag: "03 · WebGL · Three.js · Astro · Interactive",
    title: "Interactive 3D Space Portfolio",
    description: "Interactive portfolio featuring real-time Three.js WebGL space simulation, custom interactive particle rendering, and fast Astro architecture.",
    link: "https://github.com/Roberto-Vinicius",
  },
];
---

<BaseLayout
  title={homeSeo.title}
  description={homeSeo.description}
  locale={locale}
  path={`/${locale}/`}
  alternatePaths={alternatePaths}
  immersive
  showLocaleSwitch={false}
>
  <!-- TOOLBAR / NAVBAR FIXA -->
  <header class="app-toolbar">
    <div class="toolbar-container">
      <a href="#perfil" class="toolbar-brand">
        <span class="brand-prefix">root@</span><span class="brand-name">robertovinicius</span><span class="brand-suffix">:~#</span>
      </a>

      <!-- Menu de Navegação Desktop -->
      <nav class="toolbar-nav" aria-label="Navegação Principal">
        <ul class="nav-menu">
          {navItems.map((item) => (
            <li class="nav-item">
              <a href={item.href} class="nav-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Seletor de Idioma e Botão Mobile -->
      <div class="toolbar-actions">
        <a
          href={alternatePaths[locale === "pt" ? "en" : "pt"]}
          class="lang-pill"
          aria-label={locale === "pt" ? "Switch to English" : "Mudar para Português"}
        >
          {locale === "pt" ? "EN" : "PT"}
        </a>
        <button id="mobile-toggle" class="mobile-toggle-btn" aria-label="Menu" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>

    <!-- Menu Mobile Dropdown -->
    <div id="mobile-menu" class="mobile-dropdown">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </header>

  <!-- SEÇÃO 00: HERO COM PLANETAS 3D, PARTICULAS E BOTÕES -->
  <section id="perfil" class="hero-section" aria-label="Perfil">
    <!-- Fundo Espacial 3D (Wormhole WebGL) -->
    <iframe
      class="hero-space-frame"
      data-wormhole-frame
      src="/wormhole-home.html?locale=pt"
      title="Cenário Espacial Interativo"
      aria-hidden="true"
    ></iframe>

    <!-- Título com Partículas 3D (Tamanho Original Imersivo) -->
    <div class="title-particles" aria-hidden="true">
      <canvas data-title-particles data-title={particleTitle}></canvas>
    </div>
    <h1
      class="title-particles__fallback"
      data-title-fallback
      data-title={particleTitle}
    >
      {particleTitle}
    </h1>

    <!-- Botões Minimalistas LinkedIn e GitHub -->
    <nav class="home-social-dock" aria-label="Redes Sociais">
      <a
        href="https://www.linkedin.com/in/robertoviniciusd"
        target="_blank"
        rel="noopener noreferrer"
        class="social-btn"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <span class="social-icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63z"/></svg>
        </span>
        <span class="social-label">LinkedIn →</span>
      </a>
      <a
        href="https://github.com/Roberto-Vinicius"
        target="_blank"
        rel="noopener noreferrer"
        class="social-btn"
        aria-label="GitHub"
        title="GitHub"
      >
        <span class="social-icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
        </span>
        <span class="social-label">GitHub →</span>
      </a>
    </nav>

    <!-- Scroll Indicator -->
    <a href="#sobre" class="scroll-down-btn" aria-label="Rolar para conteúdo">
      <span>SCROLL</span>
      <span class="scroll-arrow">↓</span>
    </a>
  </section>

  <!-- CONTEÚDO PRINCIPAL COM SEÇÕES E PAGINAÇÃO VISUAL -->
  <main class="page-content">
    
    <!-- SEÇÃO 01: SOBRE MIM -->
    <section id="sobre" class="content-section">
      <div class="section-badge">[ 01 ] {locale === "pt" ? "SOBRE" : "ABOUT"}</div>
      <h2 class="section-title">{locale === "pt" ? "Um pouco sobre mim" : "A bit about me"}</h2>
      
      <div class="about-grid">
        <div class="about-bio">
          <p>
            {locale === "pt" ? (
              <>Sou <strong>Roberto Vinicius</strong>, desenvolvedor Full Stack e DevOps com experiência sólida em <strong>PHP (Laravel)</strong>, <strong>Vue.js</strong>, <strong>React</strong>, <strong>Docker</strong> e <strong>PostgreSQL</strong>.</>
            ) : (
              <>I am <strong>Roberto Vinicius</strong>, a Full Stack Developer and DevOps specialist with solid experience in <strong>PHP (Laravel)</strong>, <strong>Vue.js</strong>, <strong>React</strong>, <strong>Docker</strong>, and <strong>PostgreSQL</strong>.</>
            )}
          </p>
          <p>
            {locale === "pt" ? (
              <>Atualmente atuo como desenvolvedor e responsável por infraestrutura na <strong>Secretaria de Estado da Saúde Pública do RN (SESAP)</strong>, construindo sistemas críticos para a saúde pública e arquitetando ambientes containerizados com pipelines de CI/CD automatizados.</>
            ) : (
              <>Currently working as a software developer and DevOps engineer at <strong>SESAP/RN (State Health Secretariat)</strong>, building mission-critical public health systems and architecting containerized environments with automated CI/CD pipelines.</>
            )}
          </p>
          <p>
            {locale === "pt" ? (
              <>Graduando em <strong>Ciência e Tecnologia</strong> pela Universidade Federal do Rio Grande do Norte (UFRN - Noturno) e com formação técnica em Informática pelo Colégio Motivar.</>
            ) : (
              <>Pursuing a B.S. in <strong>Science and Technology</strong> at the Federal University of Rio Grande do Norte (UFRN) and holding technical degree in IT from Colégio Motivar.</>
            )}
          </p>
        </div>

        <div class="about-cards-column">
          <div class="info-card">
            <span class="info-label">{locale === "pt" ? "Graduação" : "Education"}</span>
            <strong class="info-val">UFRN (C&T)</strong>
          </div>
          <div class="info-card">
            <span class="info-label">{locale === "pt" ? "Atuação Atual" : "Current Role"}</span>
            <strong class="info-val">SESAP/RN (Dev & DevOps)</strong>
          </div>
          <div class="info-card">
            <span class="info-label">{locale === "pt" ? "Localização" : "Location"}</span>
            <strong class="info-val">Natal - RN, Brasil</strong>
          </div>
          <div class="info-card">
            <span class="info-label">{locale === "pt" ? "Foco Técnico" : "Main Focus"}</span>
            <strong class="info-val">Web & Cloud / DevOps</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- MARQUEE INFINITO DE TECNOLOGIAS -->
    <div class="marquee-wrapper" aria-hidden="true">
      <div class="marquee-track">
        {marqueeSkills.concat(marqueeSkills).map((item) => (
          <span class="marquee-item">{item}</span>
        ))}
      </div>
    </div>

    <!-- SEÇÃO 02: HABILIDADES (STACK) -->
    <section id="habilidades" class="content-section">
      <div class="section-badge">[ 02 ] STACK</div>
      <h2 class="section-title">{locale === "pt" ? "Tecnologias que domino" : "Technologies I use"}</h2>

      <div class="skills-grid">
        {skillsData.map((group) => (
          <div class="skill-category-box">
            <h3 class="category-name">{group.category}</h3>
            <div class="pills-container">
              {group.items.map((skill) => (
                <span class="skill-pill">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SEÇÃO 03: CARREIRA / EXPERIÊNCIA -->
    <section id="experiencia" class="content-section">
      <div class="section-badge">[ 03 ] {locale === "pt" ? "CARREIRA" : "CAREER"}</div>
      <h2 class="section-title">{locale === "pt" ? "Experiência profissional" : "Professional experience"}</h2>

      <div class="timeline-container">
        {experiences.map((exp) => (
          <article class="timeline-entry">
            <div class="timeline-top">
              <div>
                <h3 class="role-title">{exp.role}</h3>
                <span class="company-badge">{exp.company}</span>
              </div>
              <time class="period-tag">{exp.period}</time>
            </div>
            <p class="timeline-text">{exp.description}</p>
            <div class="tags-row">
              {exp.tags.map((tag) => (
                <span class="tech-tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SEÇÃO 04: PROJETOS -->
    <section id="projetos" class="content-section">
      <div class="section-badge">[ 04 ] {locale === "pt" ? "PROJETOS" : "PROJECTS"}</div>
      <h2 class="section-title">{locale === "pt" ? "Projetos em destaque" : "Featured projects"}</h2>

      <div class="projects-grid">
        {projects.map((proj) => (
          <div class="project-card">
            <div class="project-tag">{proj.tag}</div>
            <h3 class="project-title">{proj.title}</h3>
            <p class="project-desc">{proj.description}</p>
            <div class="project-bottom">
              <a href={proj.link} target="_blank" rel="noopener noreferrer" class="project-link-btn">
                {locale === "pt" ? "Ver projeto" : "View project"} <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SEÇÃO 05: CONTATO -->
    <section id="contato" class="content-section">
      <div class="section-badge">[ 05 ] {locale === "pt" ? "CONTATO" : "CONTACT"}</div>
      <h2 class="section-title">{locale === "pt" ? "Bora construir soluções juntos?" : "Let's build something great together"}</h2>

      <div class="contact-card">
        <p class="contact-lead">
          {locale === "pt"
            ? "Disponível para novos projetos full stack, arquitetura DevOps ou consultoria técnica. Respondo com rapidez."
            : "Available for full stack engineering, DevOps architecture, or consulting opportunities. Get in touch."}
        </p>

        <a href="mailto:robertodantas1030@gmail.com" class="email-cta">
          robertodantas1030@gmail.com
        </a>

        <div class="contact-links-row">
          <a href="mailto:robertodantas1030@gmail.com" class="contact-link">Email</a>
          <a href="https://www.linkedin.com/in/robertoviniciusd" target="_blank" rel="noopener noreferrer" class="contact-link">LinkedIn</a>
          <a href="https://github.com/Roberto-Vinicius" target="_blank" rel="noopener noreferrer" class="contact-link">GitHub</a>
          <a href="tel:+5584994056581" class="contact-link">(84) 99405-6581</a>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="app-footer">
    <div class="footer-inner">
      <p>© {new Date().getFullYear()} Roberto Vinicius Dantas Batista · {locale === "pt" ? "Todos os direitos reservados" : "All rights reserved"}</p>
      <div class="footer-terminal">root@robertovinicius:~# exit 0</div>
    </div>
  </footer>
</BaseLayout>

<script src="../../scripts/title-particles.ts"></script>

<script>
  // Script para o menu mobile da Toolbar
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('active');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<style>
  /* =========================================================
     TOOLBAR / NAVBAR FIXA
     ========================================================= */
  .app-toolbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    background: rgba(3, 5, 11, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .toolbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .toolbar-brand {
    font-family: monospace, Courier, monospace;
    font-size: 0.92rem;
    text-decoration: none;
    letter-spacing: 0.03em;
    color: #f8fafc;
    transition: opacity 0.2s;
  }
  .toolbar-brand:hover {
    opacity: 0.8;
  }
  .brand-prefix { color: #38bdf8; }
  .brand-name { color: #ffffff; font-weight: bold; }
  .brand-suffix { color: #94a3b8; }

  .toolbar-nav {
    display: flex;
    align-items: center;
  }

  .nav-menu {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.88rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 500;
    transition: all 0.2s ease;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
  }

  .nav-link:hover {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-pill {
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.35);
    background: rgba(56, 189, 248, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-family: monospace;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.2s;
  }

  .lang-pill:hover {
    background: rgba(56, 189, 248, 0.25);
    border-color: #38bdf8;
  }

  .mobile-toggle-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .mobile-toggle-btn .bar {
    width: 22px;
    height: 2px;
    background: #f8fafc;
    border-radius: 2px;
  }

  .mobile-dropdown {
    display: none;
    background: rgba(3, 5, 11, 0.98);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 1.5rem;
  }
  .mobile-dropdown.active {
